# ─── CloudVisor Docker Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your secure values.
# These override the defaults in docker-compose.yml.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — default: cvpassword
POSTGRES_PASSWORD=change-me-to-a-secure-password

# Neo4j — default: neo4j/password
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-secure-password

# Elasticsearch — default: elastic/elasticpassword
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=change-me-to-a-secure-password

# NVIDIA AI API Key (Copilot service) — required for AI-powered features
COPILOT_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
