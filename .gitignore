dist/
build/
target/
*/dist/

# ─── Database volumes ────────────────────────────────────────────────────────
infra/db/postgres/
infra/db/neo4j/

# ─── Misc ────────────────────────────────────────────────────────────────────
.qwen/
*.ruff_cache/

# ─── Next.js build output ────────────────────────────────────────────────────
.next/
**/.next/
*.tsbuildinfo

