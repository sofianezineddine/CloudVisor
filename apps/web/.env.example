# CloudVisor Web Application Environment Variables

# ─── Service URLs ─────────────────────────────────────────────────────────────
# Auth Service (authentication & user management)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002

# API Gateway (all v1/* endpoints — findings, assets, compliance, accounts)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8005

# Connector Service (direct access for cloud account management & discovery)
# In production this should point to the API gateway, not the connector directly.
NEXT_PUBLIC_CONNECTOR_BASE_URL=http://localhost:8000

# AIOps (Keep) Service — used by the Keep UI frontend
API_URL=http://localhost:8011
NEXT_PUBLIC_AIOPS_URL=http://localhost:8011

# Keep UI Frontend URL (standalone Next.js app on port 3003)
NEXT_PUBLIC_KEEP_UI_URL=http://localhost:3003

# Authentication
NEXT_PUBLIC_AUTH_PROVIDER=local
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-change-in-production

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_TELEMETRY=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# Cloud Provider Credentials (for discovery)
AWS_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT_ID=
OCI_COMPARTMENT_OCID=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# OPA
OPA_URL=http://localhost:8181

# Soketi (WebSocket / Pusher-compatible)
NEXT_PUBLIC_SOKETI_HOST=localhost
NEXT_PUBLIC_SOKETI_PORT=6001
NEXT_PUBLIC_SOKETI_KEY=cv-soketi-key
NEXT_PUBLIC_SOKETI_CLUSTER=mt1

# Pusher.js Client (AIOps real-time updates via Soketi)
# These must match the SOKETI_DEFAULT_APP_KEY in docker-compose.yml
NEXT_PUBLIC_PUSHER_KEY=cloudvisor-key
NEXT_PUBLIC_PUSHER_HOST=localhost
NEXT_PUBLIC_PUSHER_PORT=6001

# Logging
LOG_LEVEL=info
NEXT_PUBLIC_LOG_LEVEL=warn
