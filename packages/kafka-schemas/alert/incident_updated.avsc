{
  "type": "record",
  "name": "IncidentUpdatedEvent",
  "namespace": "cloudvisor.alert",
  "doc": "Emitted when an incident status or composition changes",
  "fields": [
    {"name": "event_type", "type": "string", "default": "incident.updated"},
    {"name": "incident_id", "type": "string"},
    {"name": "organization_id", "type": "string"},
    {"name": "status", "type": "string"},
    {"name": "severity", "type": "string"},
    {"name": "timestamp", "type": "long", "logicalType": "timestamp-millis"}
  ]
}
