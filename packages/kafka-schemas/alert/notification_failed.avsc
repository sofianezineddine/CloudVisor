{
  "type": "record",
  "name": "NotificationFailedEvent",
  "namespace": "cloudvisor.alert",
  "doc": "Emitted when a notification delivery fails",
  "fields": [
    {"name": "event_type", "type": "string", "default": "notification.failed"},
    {"name": "finding_id", "type": "string"},
    {"name": "channel_id", "type": "string"},
    {"name": "channel_type", "type": "string"},
    {"name": "organization_id", "type": "string"},
    {"name": "error", "type": ["null", "string"], "default": null},
    {"name": "timestamp", "type": "long", "logicalType": "timestamp-millis"}
  ]
}
