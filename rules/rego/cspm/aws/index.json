{
  "version": "1.0.0",
  "rules": [
    {"id": "aws-cloudtrail-disabled", "file": "cloudtrail_disabled.rego", "title": "CloudTrail is not enabled", "severity": "HIGH", "provider": "aws", "category": "cspm", "resource_type": "aws::cloudtrail::trail", "compliance": [{"framework": "CIS-AWS", "control": "3.1"}, {"framework": "SOC2", "control": "CC7.2"}, {"framework": "PCI-DSS", "control": "10.1"}]},
