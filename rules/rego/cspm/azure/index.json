{
  "version": "1.0.0",
  "rules": [
    {"id": "azure-nsg-unrestricted-ssh", "file": "nsg_unrestricted_ssh.rego", "title": "Azure NSG allows unrestricted SSH access", "severity": "CRITICAL", "provider": "azure", "category": "cspm", "resource_type": "azure::network::networksecuritygroup", "compliance": [{"framework": "CIS-Azure", "control": "6.2"}, {"framework": "SOC2", "control": "CC6.6"}]},
    {"id": "azure-storage-public-access", "file": "storage_public_access.rego", "title": "Azure Storage Account allows public blob access", "severity": "HIGH", "provider": "azure", "category": "cspm", "resource_type": "azure::storage::storageaccount", "compliance": [{"framework": "CIS-Azure", "control": "3.5"}, {"framework": "SOC2", "control": "CC6.1"}]},
    {"id": "azure-vm-no-managed-identity", "file": "vm_no_managed_identity.rego", "title": "Azure VM does not use managed identity", "severity": "MEDIUM", "provider": "azure", "category": "cspm", "resource_type": "azure::compute::virtualmachine", "compliance": [{"framework": "CIS-Azure", "control": "9.1"}]},
    {"id": "azure-sql-no-auditing", "file": "sql_no_auditing.rego", "title": "Azure SQL Server has no auditing enabled", "severity": "MEDIUM", "provider": "azure", "category": "cspm", "resource_type": "azure::sql::server", "compliance": [{"framework": "SOC2", "control": "CC7.2"}, {"framework": "PCI-DSS", "control": "10.2"}]},
    {"id": "azure-keyvault-soft-delete", "file": "keyvault_soft_delete.rego", "title": "Azure Key Vault soft delete is not enabled", "severity": "HIGH", "provider": "azure", "category": "cspm", "resource_type": "azure::keyvault::vault", "compliance": [{"framework": "SOC2", "control": "A1.2"}]},
    {"id": "azure-vm-disk-encryption", "file": "vm_disk_encryption.rego", "title": "Azure VM OS disk is not encrypted", "severity": "HIGH", "provider": "azure", "category": "cspm", "resource_type": "azure::compute::virtualmachine", "compliance": [{"framework": "CIS-Azure", "control": "7.2"}, {"framework": "SOC2", "control": "CC6.1"}, {"framework": "HIPAA", "control": "164.312(a)(2)(iv)"}]},
    {"id": "azure-aks-rbac-disabled", "file": "aks_rbac_disabled.rego", "title": "Azure AKS cluster does not have RBAC enabled", "severity": "HIGH", "provider": "azure", "category": "cspm", "resource_type": "azure::containerservice::managedcluster", "compliance": [{"framework": "CIS-Azure", "control": "8.5"}, {"framework": "NIST-800-53", "control": "AC-6"}]},
    {"id": "azure-ad-mfa-disabled", "file": "ad_mfa_disabled.rego", "title": "Azure AD user does not have MFA enabled", "severity": "HIGH", "provider": "azure", "category": "cspm", "resource_type": "azure::aad::user", "compliance": [{"framework": "CIS-Azure", "control": "1.1"}, {"framework": "SOC2", "control": "CC6.1"}, {"framework": "PCI-DSS", "control": "8.4.2"}]}
  ]
