{
  "version": "1.0.0",
  "rules": [
    {"id": "gcp-bucket-public-access", "file": "bucket_public_access.rego", "title": "GCP Cloud Storage bucket is publicly accessible", "severity": "CRITICAL", "provider": "gcp", "category": "cspm", "resource_type": "gcp::storage::bucket", "compliance": [{"framework": "CIS-GCP", "control": "5.1"}, {"framework": "SOC2", "control": "CC6.1"}]},
    {"id": "gcp-firewall-unrestricted-ssh", "file": "firewall_unrestricted_ssh.rego", "title": "GCP firewall rule allows unrestricted SSH access", "severity": "CRITICAL", "provider": "gcp", "category": "cspm", "resource_type": "gcp::compute::firewall", "compliance": [{"framework": "CIS-GCP", "control": "3.6"}, {"framework": "SOC2", "control": "CC6.6"}]},
    {"id": "gcp-sql-public-ip", "file": "sql_public_ip.rego", "title": "GCP Cloud SQL instance has a public IP", "severity": "HIGH", "provider": "gcp", "category": "cspm", "resource_type": "gcp::sqladmin::instance", "compliance": [{"framework": "CIS-GCP", "control": "6.2"}, {"framework": "SOC2", "control": "CC6.6"}]},
    {"id": "gcp-gke-legacy-auth", "file": "gke_legacy_auth.rego", "title": "GKE cluster has legacy authorization enabled", "severity": "HIGH", "provider": "gcp", "category": "cspm", "resource_type": "gcp::container::cluster", "compliance": [{"framework": "CIS-GCP", "control": "7.3"}, {"framework": "NIST-800-53", "control": "AC-6"}]},
    {"id": "gcp-bigquery-public-dataset", "file": "bigquery_public_dataset.rego", "title": "GCP BigQuery dataset is publicly accessible", "severity": "CRITICAL", "provider": "gcp", "category": "cspm", "resource_type": "gcp::bigquery::dataset", "compliance": [{"framework": "CIS-GCP", "control": "7.1"}, {"framework": "SOC2", "control": "CC6.6"}, {"framework": "GDPR", "control": "Art.32"}]},
    {"id": "gcp-iam-service-account-key-rotation", "file": "iam_service_account_key_rotation.rego", "title": "GCP service account key not rotated in 90+ days", "severity": "HIGH", "provider": "gcp", "category": "cspm", "resource_type": "gcp::iam::serviceaccount", "compliance": [{"framework": "CIS-GCP", "control": "1.7"}, {"framework": "SOC2", "control": "CC6.1"}]},
    {"id": "gcp-kms-key-rotation", "file": "kms_key_rotation.rego", "title": "GCP KMS key rotation is not enabled", "severity": "MEDIUM", "provider": "gcp", "category": "cspm", "resource_type": "gcp::cloudkms::cryptokey", "compliance": [{"framework": "CIS-GCP", "control": "1.10"}, {"framework": "SOC2", "control": "CC6.1"}]},
    {"id": "gcp-compute-serial-port-enabled", "file": "compute_serial_port_enabled.rego", "title": "GCP Compute instance has serial port access enabled", "severity": "MEDIUM", "provider": "gcp", "category": "cspm", "resource_type": "gcp::compute::instance", "compliance": [{"framework": "CIS-GCP", "control": "4.5"}, {"framework": "NIST-800-53", "control": "AC-17"}]}
  ]
}
