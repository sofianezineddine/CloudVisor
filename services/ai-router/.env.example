# AI Router Service Configuration
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# Service Port
PORT=8015

# =============================================================================
# LLM Provider API Keys
# =============================================================================

# OpenAI (also used for OpenRouter if base URL is set)
OPENAI_API_KEY=sk-...

# OpenRouter (optional - can use OPENAI_API_KEY with OPENAI_BASE_URL)
OPENROUTER_API_KEY=sk-or-v1-...

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-...

# =============================================================================
# Provider Base URLs (optional - defaults will be used if not set)
# =============================================================================

OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# =============================================================================
# Default Model Configuration
# =============================================================================

# Default provider when none specified (openai, openrouter, nvidia)
DEFAULT_PROVIDER=openai

# Default models per provider
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-405b-instruct

# =============================================================================
# Rate Limiting & Performance
# =============================================================================

# Max requests per minute per tenant
RATE_LIMIT_RPM=60

# Request timeout in seconds
REQUEST_TIMEOUT=60

# Max tokens per request
MAX_TOKENS=4096

# =============================================================================
# Redis (optional - for caching and rate limiting)
# =============================================================================

REDIS_URL=redis://localhost:6379/8
ENABLE_CACHE=true
CACHE_TTL=3600
