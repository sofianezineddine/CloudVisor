# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Alert Service Environment Variables
# Port: 8004
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/3
REDIS_PASSWORD=
REDIS_DB=3

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=alert

# ─── Alert Core ──────────────────────────────────────────────────────────────
ALERT_SERVICE_NAME=alert
ALERT_NOTIFICATION_RATE_LIMIT=10
ALERT_NOTIFICATION_DEDUP_WINDOW_SECONDS=300
ALERT_BULK_OPERATION_BATCH_SIZE=500

# ─── SLA Targets ─────────────────────────────────────────────────────────────
ALERT_SLA_CRITICAL_ACKNOWLEDGE_HOURS=4
ALERT_SLA_CRITICAL_RESOLVE_HOURS=24
ALERT_SLA_HIGH_ACKNOWLEDGE_HOURS=24
ALERT_SLA_HIGH_RESOLVE_DAYS=7
ALERT_SLA_MEDIUM_ACKNOWLEDGE_DAYS=7
ALERT_SLA_MEDIUM_RESOLVE_DAYS=30

# ─── Notification Channels (optional — configured via API) ───────────────────
# Slack webhook URL (can also be set per-channel via the API)
ALERT_SLACK_WEBHOOK_URL=
# Jira base URL + credentials (can also be set per-channel via the API)
ALERT_JIRA_BASE_URL=
ALERT_JIRA_USERNAME=
ALERT_JIRA_API_TOKEN=
# SMTP for email notifications
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=noreply@cloudvisor.io

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317
