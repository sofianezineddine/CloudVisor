# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Public API Gateway Environment Variables
# Port: 8005
# ─────────────────────────────────────────────────────────────────────────────

# ─── Redis (rate limiting) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/4
REDIS_PASSWORD=
REDIS_DB=4

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=api

# ─── Upstream Service URLs ────────────────────────────────────────────────────
# Use container names when running in Docker, localhost when running locally
API_SERVICE_NAME=api
API_AUTH_SERVICE_URL=http://localhost:8002
API_CONNECTOR_SERVICE_URL=http://localhost:8000
API_GRAPH_SERVICE_URL=http://localhost:8001
API_POLICY_SERVICE_URL=http://localhost:8003
API_ALERT_SERVICE_URL=http://localhost:8004
API_CSPM_SERVICE_URL=http://localhost:8006
API_COPILOT_SERVICE_URL=http://localhost:8010
API_KEEP_SERVICE_URL=http://localhost:8007

# ─── Rate Limiting ───────────────────────────────────────────────────────────
API_RATE_LIMIT_REQUESTS_PER_MINUTE=600
API_RATE_LIMIT_BURST=100

# ─── CORS ────────────────────────────────────────────────────────────────────
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ─── Request Timeout ─────────────────────────────────────────────────────────
API_UPSTREAM_TIMEOUT=30.0

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317
