# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Auth Service Environment Variables
# Port: 8002
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=auth

# ─── Auth Core ───────────────────────────────────────────────────────────────
ADMIN_DEFAULT_PASSWORD=AdminPass123!
AUTH_SERVICE_NAME=auth
AUTH_SECRET_KEY=change-me-in-production-min-32-chars!
AUTH_ALGORITHM=RS256

# ─── RSA Key Pair for RS256 JWT signing (spec §3.3) ──────────────────────────
