# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Auth Service Environment Variables
# Port: 8002
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=auth

# ─── Auth Core ───────────────────────────────────────────────────────────────
AUTH_SERVICE_NAME=auth
AUTH_SECRET_KEY=change-me-in-production-min-32-chars!
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_BCRYPT_ROUNDS=12
AUTH_MFA_ISSUER=CloudVisor
AUTH_SESSION_EXPIRE_DAYS=7
AUTH_SESSION_INACTIVE_DAYS=7

# ─── API Keys ────────────────────────────────────────────────────────────────
AUTH_API_KEY_PREFIX=cv_live_
AUTH_API_KEY_LENGTH=32

# ─── Rate Limiting ───────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_PER_MINUTE=60

# ─── CORS ────────────────────────────────────────────────────────────────────
AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── RBAC Defaults ───────────────────────────────────────────────────────────
AUTH_DEFAULT_ROLE=viewer
AUTH_ENTERPRISE_ROLE=admin
AUTH_REQUIRE_MFA_ENTERPRISE=false

# ─── Password Policy ─────────────────────────────────────────────────────────
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=false

# ─── OAuth — Google ──────────────────────────────────────────────────────────
AUTH_OAUTH_GOOGLE_ENABLED=true
AUTH_OAUTH_GOOGLE_CLIENT_ID=151355705608-unp2q80ec1dnhicanme1bo9nvdug50fg.apps.googleusercontent.com
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=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

# ─── OAuth — GitHub ──────────────────────────────────────────────────────────
AUTH_OAUTH_GITHUB_ENABLED=true
AUTH_OAUTH_GITHUB_CLIENT_ID=Ov23liCw3mpZGmqHvCUR
AUTH_OAUTH_GITHUB_CLIENT_SECRET=b91db596a83cf3791734c14112fa08ce32fb64da

# ─── SSO (Enterprise) ────────────────────────────────────────────────────────
AUTH_SAML_ENABLED=false
AUTH_OIDC_ENABLED=false

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317
