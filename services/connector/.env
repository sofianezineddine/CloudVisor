# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Connector Service Environment Variables
# Port: 8000
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=connector

# ─── Connector Core ──────────────────────────────────────────────────────────
CONNECTOR_SERVICE_NAME=connector
CONNECTOR_POLLING_INTERVAL_DEFAULT=1
CONNECTOR_POLLING_INTERVAL_OPTIONS=[1,5,15,30,60]
CONNECTOR_SYNC_TIMEOUT_SECONDS=300
CONNECTOR_BATCH_SIZE=100
CONNECTOR_MAX_RETRIES=5
CONNECTOR_BASE_RETRY_DELAY_SECONDS=1.0
CONNECTOR_MAX_RETRY_DELAY_SECONDS=60.0
CONNECTOR_EVENT_TARGET_LATENCY_SECONDS=60

# ─── Circuit Breaker ─────────────────────────────────────────────────────────
CONNECTOR_CIRCUIT_BREAKER_ERROR_THRESHOLD=0.5
CONNECTOR_CIRCUIT_BREAKER_WINDOW_SECONDS=300
CONNECTOR_CIRCUIT_BREAKER_PAUSE_SECONDS=900

# ─── HashiCorp Vault (credential storage) ────────────────────────────────────
# Set VAULT_ENABLED=true in production — credentials go to Vault, not DB
VAULT_ENABLED=false
VAULT_URL=http://localhost:8200
VAULT_TOKEN=cloudvisor-root-token
# Optional: path to a file containing the Vault token (used in Docker)
VAULT_TOKEN_FILE=
VAULT_MOUNT_POINT=cloudvisor/credentials

# ─── AWS Credentials (for testing local discovery) ───────────────────────────
# Leave empty — credentials are stored per-account via the API, not here
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317
