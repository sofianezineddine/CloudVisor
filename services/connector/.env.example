# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Connector Service — Example Environment Variables
# Copy to .env and fill in real values before running.
# Port: 8000
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Confluent Schema Registry — enables Avro serialization for all Kafka events.
# When set and reachable, events are serialized as Confluent Avro wire format.
# When unset or unreachable, falls back to plain JSON (safe for local dev).
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=connector

# ─── Connector Core ──────────────────────────────────────────────────────────
CONNECTOR_SERVICE_NAME=connector
CONNECTOR_POLLING_INTERVAL_DEFAULT=1
CONNECTOR_POLLING_INTERVAL_OPTIONS=[1,5,15,30,60]
CONNECTOR_SYNC_TIMEOUT_SECONDS=300
CONNECTOR_BATCH_SIZE=100
CONNECTOR_MAX_RETRIES=5
CONNECTOR_BASE_RETRY_DELAY_SECONDS=1.0
CONNECTOR_MAX_RETRY_DELAY_SECONDS=60.0
CONNECTOR_EVENT_TARGET_LATENCY_SECONDS=60

# ─── Circuit Breaker ─────────────────────────────────────────────────────────
CONNECTOR_CIRCUIT_BREAKER_ERROR_THRESHOLD=0.5
CONNECTOR_CIRCUIT_BREAKER_WINDOW_SECONDS=300
CONNECTOR_CIRCUIT_BREAKER_PAUSE_SECONDS=900

# ─── HashiCorp Vault ─────────────────────────────────────────────────────────
VAULT_ENABLED=false
VAULT_URL=http://localhost:8200
VAULT_TOKEN=
VAULT_TOKEN_FILE=
VAULT_MOUNT_POINT=cloudvisor/credentials

# ─── AWS (optional — for local testing only) ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# AWS: CloudVisor's OWN AWS account ID (SaaS deployment).
# When set, auto-provisioned CloudVisorReadOnly roles in customer accounts
# trust THIS account root (so customer IAM user rotation doesn't break
# discovery). When empty, the role trusts the caller's own IAM user ARN
# (fine for self-hosted / dev).
CLOUDVISOR_AWS_ACCOUNT_ID=

# ─── Credential Envelope Encryption (spec §8) ────────────────────────────────
# Master key material for deriving per-organization DEKs that encrypt
# customer cloud credentials at rest (Postgres credentials_enc + Vault payload).
# Accepts: 64-char hex, base64 (≥32 bytes), or any passphrase (SHA-256'd).
# In production, set this to a value pulled from Vault / KMS / secrets manager.
# If unset, credentials are stored plaintext and a warning is logged at startup.
CONNECTOR_CREDENTIAL_MASTER_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317

# ─── Real-time Event Consumers ───────────────────────────────────────────────
# Set REALTIME_ENABLED=true to activate real-time change detection.
# Each provider consumer only starts when its required vars are set.
# Without real-time consumers, the service falls back to scheduled polling only.
REALTIME_ENABLED=false

# AWS: CloudTrail → S3 → SQS → Connector (< 60s latency)
# Create an SQS queue subscribed to the S3 bucket that receives CloudTrail logs.
CLOUDTRAIL_SQS_QUEUE_URL=
CONNECTOR_AWS_CLOUDTRAIL_REGION=us-east-1

# Azure: Azure Monitor → Event Hub → Connector
# Create an Event Hub namespace and configure Azure Monitor to stream activity logs.
AZURE_EVENT_HUB_CONNECTION_STRING=
AZURE_EVENT_HUB_NAME=cloudvisor-activity-logs
CONNECTOR_AZURE_EVENT_HUB_CONSUMER_GROUP=$Default

# GCP: Cloud Asset Inventory → Pub/Sub → Connector
# Run: gcloud asset feeds create cloudvisor-feed --pubsub-topic=projects/PROJECT/topics/TOPIC
GCP_PUBSUB_SUBSCRIPTION=

# OCI: OCI Events → Streaming → Connector
# Create an OCI Stream and configure OCI Events to deliver to it.
OCI_STREAM_OCID=
OCI_STREAM_ENDPOINT=
