# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Copilot Service (CloudVisor Q) Environment Variables
# Port: 8010
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/6
REDIS_PASSWORD=
REDIS_DB=6

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=copilot

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: ollama | openrouter | google | openai | nvidia
COPILOT_SERVICE_NAME=copilot
COPILOT_LLM_PROVIDER=nvidia
COPILOT_OLLAMA_MODEL=deepseek-r1:7b
COPILOT_OLLAMA_TIMEOUT=600

# ─── Ollama (local LLM — no API key needed) ──────────────────────────────────
COPILOT_OLLAMA_BASE_URL=http://localhost:11434
COPILOT_OLLAMA_MODEL=deepseek-r1:7b
COPILOT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
COPILOT_OLLAMA_TIMEOUT=300

# ─── OpenRouter ──────────────────────────────────────────────────────────────
COPILOT_OPENROUTER_API_KEY=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
COPILOT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COPILOT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
COPILOT_OPENROUTER_APP_NAME=CloudVisor Q
COPILOT_OPENROUTER_SITE_URL=

# ─── Google Gemini ───────────────────────────────────────────────────────────
COPILOT_GOOGLE_API_KEY=
COPILOT_GOOGLE_MODEL=gemini-2.0-flash-lite
COPILOT_GOOGLE_MAX_TOKENS=2048
COPILOT_GOOGLE_TEMPERATURE=0.1

# ─── OpenAI ──────────────────────────────────────────────────────────────────
COPILOT_OPENAI_API_KEY=
COPILOT_OPENAI_MODEL=gpt-4
COPILOT_EMBEDDING_MODEL=text-embedding-3-small
COPILOT_EMBEDDING_DIMENSIONS=1536

# ─── NVIDIA API ──────────────────────────────────────────────────────────────
COPILOT_NVIDIA_API_KEY=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
COPILOT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
COPILOT_NVIDIA_MODEL=meta/llama-3.1-70b-instruct
COPILOT_NVIDIA_MAX_TOKENS=1024
COPILOT_NVIDIA_TEMPERATURE=0.7

# ─── General LLM Settings ────────────────────────────────────────────────────
COPILOT_MAX_TOKENS=2048
COPILOT_TEMPERATURE=0.1

# ─── RAG Configuration ───────────────────────────────────────────────────────
COPILOT_MAX_CONTEXT_TOKENS=128000
COPILOT_RETRIEVAL_TIMEOUT_SECONDS=15
COPILOT_MAX_RETRIEVAL_RESULTS=50

# ─── Performance Targets (ms) ────────────────────────────────────────────────
COPILOT_INTENT_CLASSIFICATION_TIMEOUT_MS=300
COPILOT_RETRIEVAL_TIMEOUT_MS=2000
COPILOT_LLM_TIMEOUT_MS=8000
COPILOT_TOTAL_TIMEOUT_MS=10000

# ─── Streaming ───────────────────────────────────────────────────────────────
COPILOT_ENABLE_STREAMING=true
COPILOT_STREAM_CHUNK_SIZE=64

# ─── CORS ────────────────────────────────────────────────────────────────────
COPILOT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Internal Service URLs ───────────────────────────────────────────────────
COPILOT_GRAPH_SERVICE_URL=http://localhost:8001
COPILOT_POLICY_SERVICE_URL=http://localhost:8003
COPILOT_CIEM_SERVICE_URL=http://localhost:8007
COPILOT_CWPP_SERVICE_URL=http://localhost:8008
COPILOT_CDR_SERVICE_URL=http://localhost:8009
COPILOT_CICD_SERVICE_URL=http://localhost:8006

# ─── Elasticsearch ───────────────────────────────────────────────────────────
COPILOT_ELASTICSEARCH_URL=http://localhost:9200
COPILOT_ELASTICSEARCH_FINDINGS_INDEX=cloudvisor-findings

# ─── GitHub / GitLab (optional — for PR generation) ──────────────────────────
COPILOT_GITHUB_TOKEN=
COPILOT_GITLAB_TOKEN=
COPILOT_ENABLE_AUTO_PR=false

# ─── Audit ───────────────────────────────────────────────────────────────────
COPILOT_AUDIT_ALL_QUERIES=true
COPILOT_AUDIT_RETENTION_DAYS=90

# ─── Rate Limiting ───────────────────────────────────────────────────────────
COPILOT_RATE_LIMIT_PER_MINUTE=100
COPILOT_RATE_LIMIT_PER_HOUR=1000

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317
