# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Graph Service Environment Variables
# Port: 8001
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=
REDIS_DB=1

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=graph

# ─── Neo4j ───────────────────────────────────────────────────────────────────
GRAPH_SERVICE_NAME=graph
GRAPH_NEO4J_URI=bolt://localhost:7687
GRAPH_NEO4J_USER=neo4j
GRAPH_NEO4J_PASSWORD=password
GRAPH_NEO4J_DATABASE=neo4j
GRAPH_NEO4J_MAX_CONNECTION_LIFETIME=3600
GRAPH_NEO4J_MAX_CONNECTION_POOL_SIZE=50
GRAPH_CONNECTION_TIMEOUT=30
GRAPH_QUERY_TIMEOUT=60

# ─── Elasticsearch ───────────────────────────────────────────────────────────
GRAPH_ELASTICSEARCH_URL=http://localhost:9200
GRAPH_ELASTICSEARCH_INDEX_PREFIX=cloudvisor

# ─── Graph Settings ──────────────────────────────────────────────────────────
GRAPH_SNAPSHOT_RETENTION_DAYS=90
GRAPH_CACHE_TTL_SECONDS=60

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317
