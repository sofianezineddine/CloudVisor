# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — Policy Service — Example Environment Variables
# Copy to .env and fill in real values before running.
# Port: 8003
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/2
REDIS_PASSWORD=
REDIS_DB=2

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=policy

# ─── OPA ─────────────────────────────────────────────────────────────────────
POLICY_SERVICE_NAME=policy
POLICY_OPA_URL=http://localhost:8181
POLICY_OPA_CHECK_INTERVAL_SECONDS=60

# ─── Rego Rules ──────────────────────────────────────────────────────────────
POLICY_RULES_REPO_PATH=./rules/rego
POLICY_RULES_REPO_URL=
POLICY_RULES_REPO_BRANCH=main

# ─── Compliance ──────────────────────────────────────────────────────────────
POLICY_COMPLIANCE_CACHE_TTL=300

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317

# ─── Security ────────────────────────────────────────────────────────────────
# Token for service-to-service calls to /internal/policy/* endpoints
# Set to a strong random value in production (e.g. openssl rand -hex 32)
POLICY_INTERNAL_SERVICE_TOKEN=
