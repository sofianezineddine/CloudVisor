# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — AIOps Service Environment Variables
# Port: 8010
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/10
REDIS_PASSWORD=
REDIS_DB=10

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=aiops

# ─── AIOps Core ──────────────────────────────────────────────────────────────
AIOPS_SERVICE_NAME=aiops
AIOPS_MODEL_UPDATE_INTERVAL_HOURS=6
AIOPS_ANOMALY_THRESHOLD=0.8

# ─── ML Models ───────────────────────────────────────────────────────────────
ML_MODEL_PATH=/app/models
ML_TRAINING_ENABLED=true
ML_BATCH_SIZE=32

# ─── Upstream Services ───────────────────────────────────────────────────────
GRAPH_SERVICE_URL=http://localhost:8001
ALERT_SERVICE_URL=http://localhost:8004

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317