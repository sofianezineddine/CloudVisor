# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — CDR Service Environment Variables
# Port: 8011
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/11
REDIS_PASSWORD=
REDIS_DB=11

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=cdr

# ─── CDR Core ────────────────────────────────────────────────────────────────
CDR_SERVICE_NAME=cdr
CDR_DETECTION_INTERVAL_MINUTES=5
CDR_THREAT_THRESHOLD=0.7

# ─── Detection Rules ─────────────────────────────────────────────────────────
RULES_PATH=/app/rules
RULES_UPDATE_INTERVAL_HOURS=1

# ─── Upstream Services ───────────────────────────────────────────────────────
GRAPH_SERVICE_URL=http://localhost:8001
ALERT_SERVICE_URL=http://localhost:8004
POLICY_SERVICE_URL=http://localhost:8003

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317