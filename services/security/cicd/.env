# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — CI/CD Security Service Environment Variables
# Port: 8012
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/12
REDIS_PASSWORD=
REDIS_DB=12

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=cicd

# ─── CI/CD Security Core ─────────────────────────────────────────────────────
CICD_SERVICE_NAME=cicd
CICD_SCAN_ON_COMMIT=true
CICD_WEBHOOK_SECRET=your-webhook-secret-here

# ─── Pipeline Integration ────────────────────────────────────────────────────
GITHUB_TOKEN=
GITLAB_TOKEN=
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# ─── Upstream Services ───────────────────────────────────────────────────────
POLICY_SERVICE_URL=http://localhost:8003
ALERT_SERVICE_URL=http://localhost:8004

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317