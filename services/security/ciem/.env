# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — CIEM Service Environment Variables
# Port: 8013
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/13
REDIS_PASSWORD=
REDIS_DB=13

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=ciem

# ─── CIEM Core ───────────────────────────────────────────────────────────────
CIEM_SERVICE_NAME=ciem
CIEM_ANALYSIS_INTERVAL_HOURS=12
CIEM_PRIVILEGE_THRESHOLD=0.8

# ─── Identity Analysis ───────────────────────────────────────────────────────
IAM_ANALYSIS_ENABLED=true
PRIVILEGE_ESCALATION_DETECTION=true
UNUSED_PERMISSIONS_THRESHOLD_DAYS=90

# ─── Upstream Services ───────────────────────────────────────────────────────
GRAPH_SERVICE_URL=http://localhost:8001
ALERT_SERVICE_URL=http://localhost:8004
POLICY_SERVICE_URL=http://localhost:8003

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317