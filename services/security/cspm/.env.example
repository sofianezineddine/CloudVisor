# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — CSPM Service — Example Environment Variables
# Copy to .env and fill in real values before running.
# Port: 8006
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/5
REDIS_PASSWORD=
REDIS_DB=5

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=cspm

# ─── CSPM Core ───────────────────────────────────────────────────────────────
CSPM_SERVICE_NAME=cspm
CSPM_SCAN_INTERVAL_HOURS=24

# ─── Upstream Services ───────────────────────────────────────────────────────
POLICY_SERVICE_URL=http://localhost:8003
ALERT_SERVICE_URL=http://localhost:8004

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317
