# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — CWPP Service Environment Variables
# Port: 8014
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/14
REDIS_PASSWORD=
REDIS_DB=14

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=cwpp

# ─── CWPP Core ───────────────────────────────────────────────────────────────
CWPP_SERVICE_NAME=cwpp
CWPP_SCAN_INTERVAL_HOURS=6
CWPP_VULNERABILITY_THRESHOLD=medium

# ─── Vulnerability Scanning ─────────────────────────────────────────────────
VULN_SCANNER_ENABLED=true
VULN_DB_UPDATE_INTERVAL_HOURS=24
CONTAINER_SCANNING_ENABLED=true

# ─── Runtime Protection ─────────────────────────────────────────────────────
RUNTIME_PROTECTION_ENABLED=true
BEHAVIORAL_ANALYSIS_ENABLED=true

# ─── Upstream Services ───────────────────────────────────────────────────────
GRAPH_SERVICE_URL=http://localhost:8001
ALERT_SERVICE_URL=http://localhost:8004

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317