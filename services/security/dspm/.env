# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — DSPM Service Environment Variables
# Port: 8015
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/15
REDIS_PASSWORD=
REDIS_DB=15

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=dspm

# ─── DSPM Core ───────────────────────────────────────────────────────────────
DSPM_SERVICE_NAME=dspm
DSPM_SCAN_INTERVAL_HOURS=24
DSPM_CLASSIFICATION_THRESHOLD=0.8

# ─── Data Classification ─────────────────────────────────────────────────────
DATA_CLASSIFICATION_ENABLED=true
PII_DETECTION_ENABLED=true
SENSITIVE_DATA_PATTERNS_PATH=/app/patterns

# ─── Data Loss Prevention ────────────────────────────────────────────────────
DLP_ENABLED=true
DLP_POLICY_ENFORCEMENT=true

# ─── Upstream Services ───────────────────────────────────────────────────────
GRAPH_SERVICE_URL=http://localhost:8001
ALERT_SERVICE_URL=http://localhost:8004
POLICY_SERVICE_URL=http://localhost:8003

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317