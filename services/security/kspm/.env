# ─────────────────────────────────────────────────────────────────────────────
# CloudVisor — KSPM Service Environment Variables
# Port: 8016
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://cvadmin:cvpassword@localhost:5432/cloudvisor
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/16
REDIS_PASSWORD=
REDIS_DB=16

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=kspm

# ─── KSPM Core ───────────────────────────────────────────────────────────────
KSPM_SERVICE_NAME=kspm
KSPM_SCAN_INTERVAL_HOURS=6
KSPM_CLUSTER_DISCOVERY_ENABLED=true

# ─── Kubernetes Integration ─────────────────────────────────────────────────
KUBECONFIG_PATH=/app/.kube/config
K8S_NAMESPACE_FILTER=
K8S_ADMISSION_CONTROLLER_ENABLED=false

# ─── Policy Enforcement ─────────────────────────────────────────────────────
OPA_GATEKEEPER_ENABLED=false
POLICY_VIOLATIONS_BLOCK=false

# ─── Upstream Services ───────────────────────────────────────────────────────
POLICY_SERVICE_URL=http://localhost:8003
ALERT_SERVICE_URL=http://localhost:8004
GRAPH_SERVICE_URL=http://localhost:8001

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_OTLP_ENDPOINT=http://localhost:4317